PORT=4000
NODE_ENV=development

# MongoDB Connection String (Replace with your MongoDB Atlas or local MongoDB URI)
# Example Atlas URI: mongodb+srv://admin:password@cluster0.abcde.mongodb.net/doctor_tracker?retryWrites=true&w=majority
