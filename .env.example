# ==============================================================================
# DOCTOR TRACKER - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server Port (Used for local development; Vercel assigns its own port)
PORT=4000

# Environment Mode ("development" or "production")
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local MongoDB URI:
# MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker
#
# Production MongoDB Atlas URI (REQUIRED for Vercel Deployment):
# Note: Ensure your MongoDB Atlas IP Access List includes 0.0.0.0/0 (allow from anywhere)
# because Vercel Serverless Functions use dynamic IP addresses.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/doctor_tracker?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Replace with a strong random string in production
JWT_SECRET=doctor_tracker_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS ALLOWED ORIGIN
# ------------------------------------------------------------------------------
# For local development:
FRONTEND_URL=http://localhost:3000
# For Vercel production deployment:
# FRONTEND_URL=https://your-frontend.vercel.app
